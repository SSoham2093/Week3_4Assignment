r tripType = travelInfo.selectedJourneyType ? travelInfo.selectedJourneyType.value : null;\n    var totalPax = travelInfo.seatWiseSelectedPaxInformation ? travelInfo.seatWiseSelectedPaxInformation.totalCount : null;\n    var daysToDeparture = "";\n    const currentDate = new Date();\n    const targetDate = new Date(journeyDate);\n    const differenceInMs = targetDate - currentDate;\n    const differenceInDays = Math.floor(differenceInMs / (1000 * 60 * 60 * 24));\n    var propensityType = "";\n    if(((tripType == "oneWay") && isInternational == true && differenceInDays <= 3 && paxCount >= 1) || ((tripType == "oneWay") && isInternational == true && differenceInDays > 3 && paxCount > 1))\n    {\n        propensityType = "highPropensity"\n    }\n\n    // Check if specialFareLabel exists\n    if (specialFareLabel) {\n        console.info("Special Fare Label:", specialFareLabel); // Output: "Students"\n        adobe.target.getOffer({\n        "mbox": "mboxSpecialFareType",\n        "params": {\n            "profile.specialfaretype": specialFareLabel,\n            "profile.propensityType": propensityType,\n            "profile.ndo": differenceInDays,\n            "profile.paxCount": totalPax\n        },\n        "success": function (offer) {\n            adobe.target.applyOffer({\n                "mbox": "mboxSpecialFareType",\n                "offer": offer\n            });\n        },\n        "error": function (status, error) {\n            console.log(\'Error\', status, error);\n        }\n    });\n    } else {\n        console.info("Special Fare Label is not available");\n         adobe.target.getOffer({\n        "mbox": "mboxSpecialFareType",\n        "params": {\n            "profile.propensityType": propensityType,\n            "profile.tripType":tripType,\n            "isInternational":isInternational,\n            "profile.ndo": differenceInDays,\n            "profile.paxCount": totalPax\n        },\n        "success": function (offer) {\n            adobe.target.applyOffer({\n                "mbox": "mboxSpecialFareType",\n                "offer": offer\n            });\n        },\n        "error": function (status, error) {\n            console.log(\'Error\', status, error);\n        }\n    });\n    }\n} else {\n    console.info("No data found in localStorage");\n}',language:"javascript"},timeout:2e3,delayNext:!0},{modulePath:"adobe-target/lib/addGlobalMboxParams.js",settings:{mboxParams:{ccid:{value:"%ccid%",checked:!0},fh_Seat:{value:"%fh_Seat%",checked:!0},fh_Prime:{value:"%fh_Prime%",checked:!0},metaData:{value:"%metaData%||%wegaCookie%",checked:!0},roleType:{value:"%roleType%",checked:!1},fh_Sports:{value:"%fh_Sports%",checked:!0},fh_Travel:{value:"%fh_Travel%",checked:!0},fh_DepDate:{value:"%fh_DepDate%",checked:!0},journeyEnd:{value:"%Journey End%",checked:!1},"login type":{value:"%Login Type%",checked:!1},fh_MealFlag:{value:"%fh_MealFlag%",checked:!0},journeyType:{value:"%Journey Type%",checked:!1},journeyStart:{value:"%Journey Start%",checked:!1},utm_campaign:{value:"%utm_campaign%",checked:!0},FHATFareFlight:{value:"%FHATFareFlight%",checked:!0},FHATFareSource:{value:"%FHATFareSource%",checked:!0},fh_FastForward:{value:"%fh_FastForward%",checked:!0},FHATFareDepDate:{value:"%FHATFareDepDate%",checked:!0},fh_ExcessBaggage:{value:"%fh_ExcessBaggage%",checked:!0},FHATFareFlexiFlag:{value:"%FHATFareFlexiFlag%",checked:!0},FHATFareSaverFlag:{value:"%FHATFareSaverFlag%",checked:!0},FHATFareSuperFlag:{value:"%FHATFareSuperFlag%",checked:!0},FHATAncillaryFlight:{value:"%FHATAncillaryFlight%",checked:!0},FHATAncillarySource:{value:"%FHATAncillarySource%",checked:!0},FHATFareDestination:{value:"%FHATFareDestination%",checked:!0},FHATAncillaryDepDate:{value:"%FHATAncillaryDepDate%",checked:!0},isInternationalSource:{value:"%Flight Source Value%",checked:!1},FHATFareUpsellFlexiFlag:{value:"%FHATFareUpsellFlexiFlag%",checked:!0},FHATFareUpsellSaverFlag:{value:"%FHATFareUpsellSaverFlag%",checked:!0},FHATFareUpsellSuperFlag:{